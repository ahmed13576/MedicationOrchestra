# --- Build context hygiene ---------------------------------------------------
# NOTE: the previous version excluded `data/`, which is where the DDI corpus
# lived. The deployed image therefore contained zero interaction records while
# the API still returned "no interactions found". The knowledge base is now
# explicitly INCLUDED, and a health check fails the deploy if it is missing.
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# --- Secrets (never ship) ----------------------------------------------------
service-account.json
.env
*.env
*.log

# --- Tests and dev artifacts -------------------------------------------------
tests/
.coverage
htmlcov/
dist/
build/
